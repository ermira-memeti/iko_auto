PREFIX iko: <https://example.org/iko-auto/v2#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?policyName ?versionName ?coverageName WHERE {
  ?policy a iko:AutoPolicy ; rdfs:label ?policyName ; iko:hasVersion ?version .
  ?version rdfs:label ?versionName ; iko:hasCoverage ?coverage .
  ?coverage rdfs:label ?coverageName .
}
ORDER BY ?policyName ?coverageName
