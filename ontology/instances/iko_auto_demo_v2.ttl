iko:Premium a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:VehiclePartDamage a owl:Class ;
    rdfs:subClassOf iko:DamageType .

iko:VehicleType a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:blue_b_2026_autopolicy_policy a iko:AutoPolicy ;
    rdfs:label "Blue Shield Motor Auto Policy B-2026" ;
    iko:alias "b-2026",
        "blue",
        "blue shield",
        "blue shield motor" ;
    iko:hasVersion iko:blue_b_2026_policyversion_2026_b ;
    iko:policyIdentifier "blue_b_2026" .

iko:green_g_2026_autopolicy_policy a iko:AutoPolicy ;
    rdfs:label "Green Road Auto Policy G-2026" ;
    iko:alias "g-2026",
        "green",
        "green road",
        "green road auto" ;
    iko:hasVersion iko:green_g_2026_policyversion_2026_c ;
    iko:policyIdentifier "green_g_2026" .

iko:hasException a owl:ObjectProperty ;
    rdfs:domain iko:Exclusion ;
    rdfs:range iko:Exception .

iko:orange_o_2026_autopolicy_policy a iko:AutoPolicy ;
    rdfs:label "Orange Insurance Auto Policy O-2026" ;
    iko:alias "o-2026",
        "orange",
