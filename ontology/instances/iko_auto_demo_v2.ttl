iko:passage_04a1f31b52a18c79954d a iko:SourcePassage ;
    iko:sourceDocumentId "blue_terms.txt" ;
    iko:sourceQuote "The deductible for an eligible Blue Shield collision claim is EUR 500 per claim." .

iko:passage_0bc48b4e82a76bc75b67 a iko:SourcePassage ;
    iko:sourceDocumentId "orange_exclusions.txt" ;
    iko:sourceQuote "Under Orange collision coverage, damage occurring during organized motor racing is excluded." .

iko:passage_4054ef432c3fe71d690b a iko:SourcePassage ;
    iko:sourceDocumentId "green_coverage.txt" ;
    iko:sourceQuote "Fire coverage compensates direct damage to the insured vehicle caused by an accidental vehicle fire." .

iko:passage_5977c7aef4009e5beb05 a iko:SourcePassage ;
    iko:sourceDocumentId "orange_terms.txt" ;
    iko:sourceQuote "The maximum payment for collision damage under this sample is EUR 15,000." .

iko:passage_7361ec7af245abdeced7 a iko:SourcePassage ;
    iko:sourceDocumentId "blue_coverage.txt" ;
    iko:sourceQuote "Collision coverage under Blue Shield Motor reimburses accidental damage to the policyholder vehicle resulting from a crash involving another automobile." .

iko:passage_9424a239e53e4bdfab8c a iko:SourcePassage ;
    iko:sourceDocumentId "blue_terms.txt" ;
    iko:sourceQuote "The maximum payment under collision coverage is EUR 20,000." .

iko:passage_a441bfa1eec46daeacbd a iko:SourcePassage ;
    iko:sourceDocumentId "orange_coverage.txt" ;
    iko:sourceQuote "Collision coverage pays for accidental physical damage to the insured vehicle caused by a collision with another vehicle or stationary object." .

iko:passage_a968826de3fa71600227 a iko:SourcePassage ;
    iko:sourceDocumentId "blue_exclusions.txt" ;
    iko:sourceQuote "Exception: ride-hailing damage is eligible only if the commercial-use endorsement is explicitly listed on policy version 2026-B." .

iko:passage_bfdf515743f301c172ea a iko:SourcePassage ;
    iko:sourceDocumentId "blue_exclusions.txt" ;
    iko:sourceQuote "Under Blue Shield collision coverage, damage from paid commercial ride-hailing use is excluded." .

iko:passage_cd2e15d5a2df2d256318 a iko:SourcePassage ;
    iko:sourceDocumentId "orange_terms.txt" ;
    iko:sourceQuote "The deductible for an eligible Orange collision claim is EUR 300 per claim." .

iko:passage_d83cd5069fbf23758ed7 a iko:SourcePassage ;
    iko:sourceDocumentId "green_exclusions.txt" ;
    iko:sourceQuote "The deductible for an eligible Green Road fire claim is EUR 250." .

iko:passage_ea75e818459941df7df3 a iko:SourcePassage ;
    iko:sourceDocumentId "orange_exclusions.txt" ;
    iko:sourceQuote "Damage deliberately caused by the insured driver is also excluded." .

iko:passage_f13483fda464f77f2837 a iko:SourcePassage ;
    iko:sourceDocumentId "green_exclusions.txt" ;
    iko:sourceQuote "Under Green Road fire coverage, fire damage intentionally caused by the policyholder is excluded." .

