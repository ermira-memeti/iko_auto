iko:effectiveDate a owl:DatatypeProperty ;
    rdfs:domain iko:PolicyVersion ;
    rdfs:range xsd:date .

iko:hasCause a owl:ObjectProperty ;
    rdfs:domain iko:ClaimEvent ;
    rdfs:range iko:CauseOfAccident .

iko:hasClaimEvent a owl:ObjectProperty ;
    rdfs:domain iko:Claim ;
    rdfs:range iko:ClaimEvent .

iko:hasDamageType a owl:ObjectProperty ;
    rdfs:domain iko:Claim ;
    rdfs:range iko:DamageType .

iko:hasDrivingHistory a owl:ObjectProperty ;
    rdfs:domain iko:Policyholder ;
    rdfs:range iko:DrivingHistory .

iko:hasEndorsement a owl:ObjectProperty ;
    rdfs:domain iko:PolicyVersion ;
    rdfs:range iko:Endorsement .

iko:hasRiskFactor a owl:ObjectProperty ;
    rdfs:domain iko:Policyholder ;
    rdfs:range iko:RiskFactor .

iko:hasSeverity a owl:ObjectProperty ;
    rdfs:domain iko:Claim ;
    rdfs:range iko:LossSeverity .

iko:hasVehicleType a owl:ObjectProperty ;
    rdfs:domain iko:Policyholder ;
    rdfs:range iko:VehicleType .

iko:indicates a owl:ObjectProperty ;
    rdfs:domain iko:FraudIndicator ;
    rdfs:range iko:SuspiciousPattern .

iko:influences a owl:ObjectProperty ;
    rdfs:domain iko:RiskFactor ;
    rdfs:range iko:Premium .

iko:policyIdentifier a owl:DatatypeProperty ;
    rdfs:domain iko:Policy ;
    rdfs:range xsd:string .

iko:policyVersionIdentifier a owl:DatatypeProperty ;
    rdfs:domain iko:PolicyVersion ;
    rdfs:range xsd:string .

iko:sourceChunkId a owl:DatatypeProperty ;
    rdfs:domain iko:SourcePassage ;
    rdfs:range xsd:string .

iko:sourceDocumentId a owl:DatatypeProperty ;
    rdfs:domain iko:SourcePassage ;
    rdfs:range xsd:string .

iko:sourceQuote a owl:DatatypeProperty ;
    rdfs:domain iko:SourcePassage ;
    rdfs:range xsd:string .

iko:supportedBy a owl:ObjectProperty ;
    rdfs:domain iko:InsuranceEntity ;
    rdfs:range iko:SourcePassage .

iko:CauseOfAccident a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:DrivingHistory a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:Endorsement a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:FraudIndicator a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:LossSeverity a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:Premium a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:VehiclePartDamage a owl:Class ;
    rdfs:subClassOf iko:DamageType .

iko:VehicleType a owl:Class ;
    rdfs:subClassOf iko:InsuranceEntity .

iko:admiral_uploaded_guide_autopolicy_policy a iko:AutoPolicy ;
    rdfs:label "Admiral Your Car Insurance Guide (uploaded edition)" ;
    iko:alias "admiral",
        "admiral car insurance" ;
    iko:hasVersion iko:admiral_uploaded_guide_policyversion_uploaded_pdf_edition_date_unconfirmed ;
    iko:policyIdentifier "admiral_uploaded_guide" .

iko:aviva_signature_uploaded_autopolicy_policy a iko:AutoPolicy ;
