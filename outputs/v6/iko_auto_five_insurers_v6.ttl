@prefix iko: <https://example.org/iko-auto/v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/iko-auto/v2> a owl:Ontology ;
    rdfs:label "IKO-Auto V6: backward-compatible five-insurer research schema"@en ;
    rdfs:comment "Functional research prototype; requires expert validation and ontology reasoner review. No formal consistency claim."@en .

iko:LateReport a owl:Class ;
    rdfs:subClassOf iko:SuspiciousPattern .

iko:MultipleClaims a owl:Class ;
    rdfs:subClassOf iko:SuspiciousPattern .

iko:affects a owl:ObjectProperty ;
    rdfs:domain iko:DamageType ;
    rdfs:range iko:VehiclePartDamage .

iko:alias a owl:DatatypeProperty ;
    rdfs:domain iko:InsuranceEntity ;
    rdfs:range xsd:string .

iko:assertionObject a owl:ObjectProperty ;
    rdfs:domain iko:RelationshipAssertion ;
    rdfs:range iko:InsuranceEntity .

iko:assertionPredicate a owl:ObjectProperty ;
    rdfs:domain iko:RelationshipAssertion ;
    rdfs:range rdf:Property .

iko:assertionSubject a owl:ObjectProperty ;
    rdfs:domain iko:RelationshipAssertion ;
    rdfs:range iko:InsuranceEntity .

